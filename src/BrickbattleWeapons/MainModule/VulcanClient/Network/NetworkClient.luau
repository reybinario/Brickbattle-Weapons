	return Value
end

function SerdesFunctions.WriteEVENT_bombUpdate(Value: { count: number, packetCount: number, position: Vector3, velocity: Vector3, tickTime: number }): ()
	-- Allocate BLOCK: 21 bytes
	local BLOCK_START = Allocate(21)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 8)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.count)
	buffer.writeu16(SendBuffer, BLOCK_START + 3, Value.packetCount)
	local Vector = Value.position
	buffer.writei16(SendBuffer, BLOCK_START + 5, Vector.X)
	buffer.writei16(SendBuffer, BLOCK_START + 7, Vector.Y)
	buffer.writei16(SendBuffer, BLOCK_START + 9, Vector.Z)
	local Vector = Value.velocity
	buffer.writei16(SendBuffer, BLOCK_START + 11, Vector.X)
	buffer.writei16(SendBuffer, BLOCK_START + 13, Vector.Y)
	buffer.writei16(SendBuffer, BLOCK_START + 15, Vector.Z)
	buffer.writef32(SendBuffer, BLOCK_START + 17, Value.tickTime)
end

function SerdesFunctions.ReadEVENT_bombReplicate(): ({ count: number, packetCount: number, player: Player, position: Vector3, velocity: Vector3, tickTime: number })
	-- Read BLOCK: 20 bytes
	local BLOCK_START = Read(20)
	local Value = {} :: any
	Value.count = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	Value.packetCount = buffer.readu16(RecieveBuffer, BLOCK_START + 2)
	RecieveInstanceCursor += 1
	Value.player = RecieveInstances[RecieveInstanceCursor]
	if typeof(Value.player) ~= "Instance" then error(`Expected an Instance, got {typeof(Value.player)} instead.`) end
	if not Value.player:IsA("Player") then error(`Expected an Instance of type "Player", got "{Value.player.ClassName}" instead.`) end
	local X = buffer.readi16(RecieveBuffer, BLOCK_START + 4)
	local Y = buffer.readi16(RecieveBuffer, BLOCK_START + 6)
	local Z = buffer.readi16(RecieveBuffer, BLOCK_START + 8)
	Value.position = Vector3.new(X, Y, Z)
	X = buffer.readi16(RecieveBuffer, BLOCK_START + 10)
	Y = buffer.readi16(RecieveBuffer, BLOCK_START + 12)
	Z = buffer.readi16(RecieveBuffer, BLOCK_START + 14)
	Value.velocity = Vector3.new(X, Y, Z)
	Value.tickTime = buffer.readf32(RecieveBuffer, BLOCK_START + 16)
	return Value
end

function SerdesFunctions.WriteEVENT_bombExplode(Value: { count: number, position: Vector3, explodedParts: { BasePart }? }): ()
	-- Allocate BLOCK: 10 bytes
	local BLOCK_START = Allocate(10)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 16)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.count)
	local Vector = Value.position
	buffer.writei16(SendBuffer, BLOCK_START + 3, Vector.X)
	buffer.writei16(SendBuffer, BLOCK_START + 5, Vector.Y)
	buffer.writei16(SendBuffer, BLOCK_START + 7, Vector.Z)
	buffer.writeu8(SendBuffer, BLOCK_START + 9, Value.explodedParts ~= nil and 1 or 0)
	if Value.explodedParts ~= nil then
		-- Allocate BLOCK: 2 bytes
		local BLOCK_START = Allocate(2)
		-- START ARRAY
		buffer.writeu16(SendBuffer, BLOCK_START + 0, #Value.explodedParts)
		for Index = 1, #Value.explodedParts do
			local Item_2 = Value.explodedParts[Index]
			table.insert(SendInstances, Item_2 or Null)
		end
		-- END ARRAY
	end
end

