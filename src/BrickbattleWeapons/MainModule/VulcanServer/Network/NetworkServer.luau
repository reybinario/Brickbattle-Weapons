function SerdesFunctions.WriteEVENT_bombReplicate(Value: { count: number, packetCount: number, player: Player, position: Vector3, velocity: Vector3, tickTime: number }): ()
	-- Allocate BLOCK: 21 bytes
	local BLOCK_START = Allocate(21)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 9)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.count)
	buffer.writeu16(SendBuffer, BLOCK_START + 3, Value.packetCount)
	table.insert(SendInstances, Value.player or Null)
	local Vector = Value.position
	buffer.writei16(SendBuffer, BLOCK_START + 5, Vector.X)
	buffer.writei16(SendBuffer, BLOCK_START + 7, Vector.Y)
	buffer.writei16(SendBuffer, BLOCK_START + 9, Vector.Z)
	local Vector = Value.velocity
	buffer.writei16(SendBuffer, BLOCK_START + 11, Vector.X)
	buffer.writei16(SendBuffer, BLOCK_START + 13, Vector.Y)
	buffer.writei16(SendBuffer, BLOCK_START + 15, Vector.Z)
	buffer.writef32(SendBuffer, BLOCK_START + 17, Value.tickTime)
end

function SerdesFunctions.ReadEVENT_bombExplode(): ({ count: number, position: Vector3, explodedParts: { BasePart }? })
	-- Read BLOCK: 9 bytes
	local BLOCK_START = Read(9)
	local Value = {} :: any
	Value.count = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	local X = buffer.readi16(RecieveBuffer, BLOCK_START + 2)
	local Y = buffer.readi16(RecieveBuffer, BLOCK_START + 4)
	local Z = buffer.readi16(RecieveBuffer, BLOCK_START + 6)
	Value.position = Vector3.new(X, Y, Z)
	if buffer.readu8(RecieveBuffer, BLOCK_START + 8) == 1 then
		-- Read BLOCK: 2 bytes
		local BLOCK_START = Read(2)
		-- START ARRAY
		local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
		if Length < 0 then error(`Expected "Length" to be larger than or equal to 0, got {Length} instead.`) end
		if Length > 65535 then error(`Expected "Length" to be smaller than or equal to 65535, got {Length} instead.`) end
		Value.explodedParts = table.create(Length)
		for Index = 1, Length do
			RecieveInstanceCursor += 1
			local Item_2 = RecieveInstances[RecieveInstanceCursor]
			if typeof(Item_2) ~= "Instance" then error(`Expected an Instance, got {typeof(Item_2)} instead.`) end
			if not Item_2:IsA("BasePart") then error(`Expected an Instance of type "BasePart", got "{Item_2.ClassName}" instead.`) end
			table.insert(Value.explodedParts, Item_2)
		end
		-- END ARRAY
	end
	return Value
end

function SerdesFunctions.WriteEVENT_bombExplodeReplicate(Value: { count: number, player: Player, position: Vector3 }): ()
	-- Allocate BLOCK: 9 bytes
	local BLOCK_START = Allocate(9)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 17)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.count)
	table.insert(SendInstances, Value.player or Null)
	local Vector = Value.position
	buffer.writei16(SendBuffer, BLOCK_START + 3, Vector.X)
	buffer.writei16(SendBuffer, BLOCK_START + 5, Vector.Y)
	buffer.writei16(SendBuffer, BLOCK_START + 7, Vector.Z)
end

function SerdesFunctions.ReadEVENT_swordGripUpdate(): ({ grip: ("Out" | "Up" | "Down") })
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	local Value = {} :: any
	Value.grip = true :: any
	local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Index == 0 then
		Value.grip = "Out"
	elseif Index == 1 then
		Value.grip = "Up"
	elseif Index == 2 then
		Value.grip = "Down"
	else
		error(`Unexpected enum: {Index}`)
	end
	return Value
end

function SerdesFunctions.ReadEVENT_wallCreate(): ({ count: number, cFrame: CFrame })
	-- Read BLOCK: 26 bytes
	local BLOCK_START = Read(26)
	local Value = {} :: any
	Value.count = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	local X = buffer.readf32(RecieveBuffer, BLOCK_START + 2)
	local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 6)
	local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 10)
	local Position = Vector3.new(X, Y, Z)
	local rX = buffer.readf32(RecieveBuffer, BLOCK_START + 14)
	local rY = buffer.readf32(RecieveBuffer, BLOCK_START + 18)
	local rZ = buffer.readf32(RecieveBuffer, BLOCK_START + 22)
	Value.cFrame = CFrame.new(Position) * CFrame.fromOrientation(rX, rY, rZ)
	return Value
end

function SerdesFunctions.ReadEVENT_deleteProjectile(): ({ projectileType: ("Superball" | "Pellet" | "Paintball" | "Rocket" | "Bomb" | "Wall"), count: number })
	-- Read BLOCK: 3 bytes
	local BLOCK_START = Read(3)
	local Value = {} :: any
	Value.projectileType = true :: any
	local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Index == 0 then
		Value.projectileType = "Superball"
	elseif Index == 1 then
		Value.projectileType = "Pellet"
	elseif Index == 2 then
		Value.projectileType = "Paintball"
	elseif Index == 3 then
		Value.projectileType = "Rocket"
	elseif Index == 4 then
		Value.projectileType = "Bomb"
	elseif Index == 5 then
		Value.projectileType = "Wall"
	else
		error(`Unexpected enum: {Index}`)
	end
	Value.count = buffer.readu16(RecieveBuffer, BLOCK_START + 1)
	return Value
end

function SerdesFunctions.WriteEVENT_deleteProjectileReplicate(Value: { projectileType: ("Superball" | "Pellet" | "Paintball" | "Rocket" | "Bomb" | "Wall"), count: number, player: Player }): ()
	-- Allocate BLOCK: 4 bytes
	local BLOCK_START = Allocate(4)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 20)
	if Value.projectileType == "Superball" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 0)
	elseif Value.projectileType == "Pellet" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 1)
	elseif Value.projectileType == "Paintball" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 2)
	elseif Value.projectileType == "Rocket" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 3)
	elseif Value.projectileType == "Bomb" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 4)
	elseif Value.projectileType == "Wall" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 5)
	else
		error(`Unexpected enum: {Value.projectileType}, expected one of "Superball" or "Pellet" or "Paintball" or "Rocket" or "Bomb" or "Wall".`)
	end
	buffer.writeu16(SendBuffer, BLOCK_START + 2, Value.count)
	table.insert(SendInstances, Value.player or Null)
end

