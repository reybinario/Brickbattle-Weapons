function SerdesFunctions.WriteEVENT_swordGripUpdate(Value: { grip: ("Out" | "Up" | "Down") }): ()
	-- Allocate BLOCK: 2 bytes
	local BLOCK_START = Allocate(2)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 10)
	if Value.grip == "Out" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 0)
	elseif Value.grip == "Up" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 1)
	elseif Value.grip == "Down" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 2)
	else
		error(`Unexpected enum: {Value.grip}, expected one of "Out" or "Up" or "Down".`)
	end
end

function SerdesFunctions.WriteEVENT_wallCreate(Value: { count: number, cFrame: CFrame }): ()
	-- Allocate BLOCK: 27 bytes
	local BLOCK_START = Allocate(27)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 18)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.count)
	local Vector = Value.cFrame.Position
	buffer.writef32(SendBuffer, BLOCK_START + 3, Vector.X)
	buffer.writef32(SendBuffer, BLOCK_START + 7, Vector.Y)
	buffer.writef32(SendBuffer, BLOCK_START + 11, Vector.Z)
	local rX, rY, rZ = Value.cFrame:ToOrientation()
	buffer.writef32(SendBuffer, BLOCK_START + 15, rX)
	buffer.writef32(SendBuffer, BLOCK_START + 19, rY)
	buffer.writef32(SendBuffer, BLOCK_START + 23, rZ)
end

function SerdesFunctions.WriteEVENT_deleteProjectile(Value: { projectileType: ("Superball" | "Pellet" | "Paintball" | "Rocket" | "Bomb" | "Wall"), count: number }): ()
	-- Allocate BLOCK: 4 bytes
	local BLOCK_START = Allocate(4)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 19)
	if Value.projectileType == "Superball" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 0)
	elseif Value.projectileType == "Pellet" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 1)
	elseif Value.projectileType == "Paintball" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 2)
	elseif Value.projectileType == "Rocket" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 3)
	elseif Value.projectileType == "Bomb" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 4)
	elseif Value.projectileType == "Wall" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 5)
	else
		error(`Unexpected enum: {Value.projectileType}, expected one of "Superball" or "Pellet" or "Paintball" or "Rocket" or "Bomb" or "Wall".`)
	end
	buffer.writeu16(SendBuffer, BLOCK_START + 2, Value.count)
end

function SerdesFunctions.ReadEVENT_deleteProjectileReplicate(): ({ projectileType: ("Superball" | "Pellet" | "Paintball" | "Rocket" | "Bomb" | "Wall"), count: number, player: Player })
	-- Read BLOCK: 3 bytes
	local BLOCK_START = Read(3)
	local Value = {} :: any
	Value.projectileType = true :: any
	local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Index == 0 then
		Value.projectileType = "Superball"
	elseif Index == 1 then
		Value.projectileType = "Pellet"
	elseif Index == 2 then
		Value.projectileType = "Paintball"
	elseif Index == 3 then
		Value.projectileType = "Rocket"
	elseif Index == 4 then
		Value.projectileType = "Bomb"
	elseif Index == 5 then
		Value.projectileType = "Wall"
	else
		error(`Unexpected enum: {Index}`)
	end
	Value.count = buffer.readu16(RecieveBuffer, BLOCK_START + 1)
	RecieveInstanceCursor += 1
	Value.player = RecieveInstances[RecieveInstanceCursor]
	if typeof(Value.player) ~= "Instance" then error(`Expected an Instance, got {typeof(Value.player)} instead.`) end
	if not Value.player:IsA("Player") then error(`Expected an Instance of type "Player", got "{Value.player.ClassName}" instead.`) end
	return Value
end

